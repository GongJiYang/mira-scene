{
  "name": "mira-scene",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "pnpm -r run typecheck",
    "smoke": "pnpm --filter @mira/server run smoke",
    "voices:record": "pnpm --filter @mira/server exec tsx scripts/record-voices.ts",
    "voices:list": "pnpm --filter @mira/server exec tsx ../../tools/voice-pack/list.ts",
    "smoke:real": "pnpm --filter @mira/server run smoke:real",
    "probe:p1": "pnpm --filter @mira/probes exec tsx p1/run.ts",
    "probe:p2": "pnpm --filter @mira/probes exec tsx p2/run.ts",
    "probe:p3": "pnpm --filter @mira/probes exec tsx p3/run.ts",
    "probe:all": "pnpm --filter @mira/probes exec tsx run-all.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
