# ── Mira 本地配置（已被 .gitignore 忽略，不会提交）──
# 填好后保存即可；不填时 PROVIDER_MODE=mock，无 Key 也能完整体验。

# 运行模式：mock（默认，无需 Key）| real（使用下面的真实服务）
PROVIDER_MODE=mock

# LLM 走哪家：deepseek（默认，OpenAI 兼容直连）| commandcode（用 Command Code 的额度，走本地 `cmd`）
LLM_PROVIDER=deepseek
# LLM_PROVIDER=commandcode 时的模型（留空用默认 deepseek/deepseek-v4-flash）
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash

# Fish Audio：语音识别（transcribe-1-pro）+ 语音合成
FISH_API_KEY=
# 角色音色 ID（Fish 音色库里选定后填写，可留空）
FISH_VOICE_ID=
# TTS 模型：s2.1-pro-free（免费）| drama-3
FISH_TTS_MODEL=s2.1-pro-free

# DeepSeek：对话模型（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 生图（拍立得显影，后续接入，可留空）
OPENAI_API_KEY=

# 限额（Q12）
SESSION_TURN_LIMIT=30
DAILY_TURN_LIMIT=300

# 故障注入默认值（留空 = 不注入；可选 llm_timeout,llm_error,tts,tts_once,stt,slow,ws_drop）
FAULTS=
